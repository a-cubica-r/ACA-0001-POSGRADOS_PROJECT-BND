  auth:
    package: ufps.edu.co.controllers.auth
    prefix: "(sin prefijo)"
    routes: [POST /auth/login, POST /auth/refresh]
  rest:
    package: ufps.edu.co.controllers.rest
    prefix: /api/dev/endpoint
    routes: CRUD genérico /{recurso}/listall|{id}|create|update|delete
